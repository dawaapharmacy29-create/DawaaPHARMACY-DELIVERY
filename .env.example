# ===============================================================
  # Dawaa Delivery — Environment Variables
  # ===============================================================
  # Copy this file to .env.local for local development
  # Set these same variables in your Vercel project settings

  # Supabase — get these from https://supabase.com → Project Settings → API
  VITE_SUPABASE_URL=https://your-project.supabase.co
  VITE_SUPABASE_ANON_KEY=your-anon-key-here

  # Optional: admin email domain for login aliases
  # VITE_ADMIN_EMAIL_DOMAIN=dawaa-delivery.local
  